+/// Records the command that opens generated documentation.
+pub fn record_open(cmd: &ProcessBuilder) -> CargoResult<()> {
+    let cmd = cmd_of(cmd)?;
+    state().lock().unwrap().steps.push(rp::Step::Open { cmd });
+    Ok(())
+}
