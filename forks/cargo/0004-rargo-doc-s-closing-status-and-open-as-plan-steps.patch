+/// rargo: while planning nothing has been generated yet, so what `doc` does
+/// after the build is recorded as steps instead: the closing status line, and
+/// for `--open` the command that opens the documentation (run by the client,
+/// in the user's session).
+fn rargo_doc_steps(
+    ws: &Workspace<'_>,
+    options: &DocOptions,
+    compilation: &Compilation<'_>,
+) -> CargoResult<()> {
+    use crate::compiler::rargo;
+    use rargo_plan::When;
+    let gctx = ws.gctx();
+    if options.open_result {
+        let name = &compilation.root_crate_names.get(0).ok_or_else(|| {
+            anyhow::anyhow!(
+                "cannot open specified crate's documentation: no documentation generated"
+            )
+        })?;
+        let kind = options.compile_opts.build_config.single_requested_kind()?;
+        let path = path_by_output_format(compilation, &kind, name, &options.output_format);
+        rargo::record_status("Opening", path.display(), When::Always);
+        let cfg: Option<crate::context::PathAndArgs> = gctx.get(["doc", "browser"])?;
+        let browser = cfg
+            .map(|pa| (pa.path.resolve_program(gctx), pa.args))
+            .or_else(|| Some((PathBuf::from(gctx.get_env_os("BROWSER")?), Vec::new())));
+        let mut cmd = match browser {
+            Some((browser, args)) => {
+                let mut cmd = ProcessBuilder::new(browser);
+                cmd.args(&args);
+                cmd
+            }
+            None => ProcessBuilder::new("xdg-open"),
+        };
+        cmd.arg(&path);
+        rargo::record_open(&cmd)?;
+        return Ok(());
+    }
+    let mut paths = Vec::new();
+    for name in &compilation.root_crate_names {
+        for kind in &options.compile_opts.build_config.requested_kinds {
+            paths.push(path_by_output_format(compilation, kind, name, &options.output_format));
+        }
+    }
+    if gctx.shell().verbosity() == Verbosity::Verbose {
+        for path in &paths {
+            rargo::record_status("Generated", path.display(), When::Always);
+        }
+    } else if let Some(first) = paths.first() {
+        let remaining = match paths.len() - 1 {
+            0 => "".to_owned(),
+            1 => " and 1 other file".to_owned(),
+            n => format!(" and {n} other files"),
+        };
+        rargo::record_status("Generated", format!("{}{remaining}", first.display()), When::Always);
+    }
+    Ok(())
+}
