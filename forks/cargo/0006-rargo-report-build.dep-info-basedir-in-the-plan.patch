From 5dd861546f1b72aac90082dc8094488fd25b9b94 Mon Sep 17 00:00:00 2001
From: sadosystems <noreply@rargo.invalid>
Date: Mon, 23 Nov 2026 02:03:01 +0100
Subject: [PATCH 6/8] rargo: report build.dep-info-basedir in the plan

---
 src/compiler/rargo.rs | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/compiler/rargo.rs b/src/compiler/rargo.rs
index 47f5b20..7dc1636 100644
--- a/src/compiler/rargo.rs
+++ b/src/compiler/rargo.rs
@@ -1,4 +1,5 @@
 
+use crate::context::ConfigRelativePathResolveExt as _;
 use std::cell::Cell;
 use std::collections::HashMap;
 use std::ffi::OsStr;
@@ -57,6 +58,7 @@ struct Global {
     keep_going: bool,
     deny_warnings: bool,
     rustc_fork: bool,
+    dep_info_basedir: Option<String>,
 }
 
 fn state() -> &'static Mutex<State> {
@@ -150,6 +152,10 @@ pub fn record_global(build_runner: &BuildRunner<'_, '_>) -> CargoResult<()> {
             .sysroot
             .join("lib/rustlib/rargo-fork")
             .exists(),
+        dep_info_basedir: match gctx.build_config()?.dep_info_basedir.clone() {
+            Some(v) => Some(s(v.resolve_path(gctx))?),
+            None => None,
+        },
     };
     let mut st = state().lock().unwrap();
     st.global = Some(g);
@@ -628,6 +634,7 @@ pub fn finish() -> CargoResult<()> {
         host: g.host,
         toolchain,
         rustc_fork: g.rustc_fork,
+        dep_info_basedir: g.dep_info_basedir,
         units,
         roots: std::mem::take(&mut st.roots),
         steps: std::mem::take(&mut st.steps),
