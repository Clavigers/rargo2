+pub fn record_test_flags(no_fail_fast: bool, test_args: &[&str]) {
+    let nocapture = test_args.contains(&"--nocapture") || test_args.contains(&"--no-capture");
+    *TEST_FLAGS.lock().unwrap() = (no_fail_fast, nocapture);
+}
+
+pub fn finish() -> CargoResult<()> {
+    #[allow(clippy::disallowed_methods)]
+    let Some(path) = std::env::var_os(rp::PLAN_ENV) else { return Ok(()) };
+    let mut st = state().lock().unwrap();
+    let Some(g) = st.global.take() else {
+        anyhow::bail!("rargo: this cargo command did not produce a build plan");
+    };
+    let mut units = Vec::with_capacity(st.units.len());
+    for (i, u) in st.units.drain(..).enumerate() {
+        match u {
+            Some(u) => units.push(u),
+            None => anyhow::bail!("rargo: unit {i} was referenced but never planned"),
+        }
+    }
+    for (i, u) in units.iter().enumerate() {
+        if u.cmd.is_none() && u.kind != rp::UnitKind::Noop {
+            anyhow::bail!("rargo: no command was recorded for unit {i} ({})", u.desc);
+        }
+    }
+    #[allow(clippy::disallowed_methods)]
+    let toolchain = std::env::var("RUSTUP_TOOLCHAIN").ok();
+    let (no_fail_fast, nocapture) = *TEST_FLAGS.lock().unwrap();
+    let plan = rp::Plan {
+        version: rp::PLAN_VERSION,
+        ws_root: g.ws_root,
+        cwd: g.cwd,
+        target_dir: g.target_dir,
+        build_dir: g.build_dir,
+        host: g.host,
+        toolchain,
+        units,
+        roots: std::mem::take(&mut st.roots),
+        steps: std::mem::take(&mut st.steps),
+        finished: g.finished,
+        message_format: g.message_format,
+        verbosity: g.verbosity,
+        extra_verbose: g.extra_verbose,
+        keep_going: g.keep_going,
+        deny_warnings: g.deny_warnings,
+        no_fail_fast,
+        nocapture,
+        dylib_var: cargo_util::paths::dylib_path_envvar().to_string(),
+        has_build: true,
+    };
+    cargo_util::paths::write(Path::new(&path), rp::encode(&plan))?;
+    Ok(())
+}
+
+pub fn pin_toolchain() {
+    #[allow(clippy::disallowed_methods)]
+    if std::env::var_os(rp::PLAN_ENV).is_none() || std::env::var_os("RUSTUP_TOOLCHAIN").is_some() {
+        return;
+    }
+    let Ok(out) = std::process::Command::new("rustup").args(["show", "active-toolchain"]).output() else {
+        return;
+    };
+    if !out.status.success() {
+        return;
+    }
+    let text = String::from_utf8_lossy(&out.stdout);
+    let Some(name) = text.split_whitespace().next() else { return };
+    unsafe {
+        std::env::set_var("RUSTUP_TOOLCHAIN", name);
+        if name.starts_with("nightly") || name.starts_with("dev") {
+            std::env::set_var("__CARGO_TEST_CHANNEL_OVERRIDE_DO_NOT_USE_THIS", "nightly");
+        }
+    }
+}
