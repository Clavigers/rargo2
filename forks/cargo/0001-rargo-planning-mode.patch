+pub fn fake_script_run(
+    cmd: &ProcessBuilder,
+    meta: &str,
+    out_dir: &Path,
+    targets: &[Target],
+) -> CargoResult<std::process::Output> {
+    record_cmd(cmd)?;
+    let mut o = String::new();
+    let mut line = |k: &str, v: String| {
+        o.push_str("cargo:");
+        o.push_str(k);
+        o.push('=');
+        o.push_str(&v);
+        o.push('\n');
+    };
+    line("rustc-cfg", token::make(token::CFG, meta));
+    line("rustc-check-cfg", token::make(token::CHECK_CFG, meta));
+    line("rustc-env", format!("{}=", token::make(token::ENV, meta)));
+    line("rustc-link-lib", token::make(token::LINK_LIB, meta));
+    line(
+        "rustc-link-search",
+        format!("{}/{}", out_dir.display(), token::make(token::LIBPATH_ARTIFACT, meta)),
+    );
+    line("rustc-link-search", token::make(token::LIBPATH_EXTERNAL, meta));
+    line("rustc-link-arg", token::link_arg("ALL", meta));
+    line("rustc-link-arg-cdylib", token::link_arg("CDYLIB", meta));
+    if targets.iter().any(|t| t.is_bin()) {
+        line("rustc-link-arg-bins", token::link_arg("BIN", meta));
+        for t in targets.iter().filter(|t| t.is_bin()) {
+            line("rustc-link-arg-bin", format!("{}={}", t.name(), token::link_arg_bin(meta, t.name())));
+        }
+    }
+    if targets.iter().any(|t| t.is_test()) {
+        line("rustc-link-arg-tests", token::link_arg("TEST", meta));
+    }
+    if targets.iter().any(|t| t.is_bench()) {
+        line("rustc-link-arg-benches", token::link_arg("BENCH", meta));
+    }
+    if targets.iter().any(|t| t.is_exe_example()) {
+        line("rustc-link-arg-examples", token::link_arg("EXAMPLE", meta));
+    }
+    line(&token::make(token::METADATA, meta), String::new());
+    use std::os::unix::process::ExitStatusExt;
+    Ok(std::process::Output {
+        status: std::process::ExitStatus::from_raw(0),
+        stdout: o.into_bytes(),
+        stderr: Vec::new(),
+    })
+}
+
+pub fn dyn_search_entry(dir: &Path, root_output: &Path) -> Option<Option<std::path::PathBuf>> {
+    let text = dir.to_str()?;
+    if text == token::NATIVE_DIRS {
+        return Some(Some(format!("{}@{}", token::NATIVE_DIRS, root_output.display()).into()));
+    }
+    let artifact = format!("{}{}_", token::PREFIX, token::LIBPATH_ARTIFACT);
+    let external = format!("{}{}_", token::PREFIX, token::LIBPATH_EXTERNAL);
+    if let Some(pos) = text.find(&artifact) {
+        let meta = text[pos + artifact.len()..].trim_end_matches(token::SUFFIX);
+        return Some(Some(
+            format!("{}@{}", token::make(token::DYN_LIBPATHS, meta), root_output.display()).into(),
+        ));
+    }
+    if text.contains(&external) {
+        return Some(None);
+    }
+    None
+}
