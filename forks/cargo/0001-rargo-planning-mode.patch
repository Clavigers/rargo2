diff --git a/src/compiler/rargo.rs b/src/compiler/rargo.rs
new file mode 100644
index 0000000..4e24773
--- /dev/null
+++ b/src/compiler/rargo.rs
@@ -0,0 +1,631 @@
+
+use std::cell::Cell;
+use std::collections::HashMap;
+use std::ffi::OsStr;
+use std::path::Path;
+use std::sync::atomic::{AtomicU8, Ordering};
+use std::sync::{Arc, Mutex, OnceLock};
+
+use cargo_util::ProcessBuilder;
+use cargo_util_schemas::manifest::TomlDebugInfo;
+use cargo_util_terminal::Verbosity;
+use rargo_plan as rp;
+use rargo_plan::token;
+
+use super::job_queue::{Job, Work};
+use super::{BuildContext, BuildRunner, CompileMode, Executor, MessageFormat, Unit};
+use crate::compiler::custom_build::LinkArgTarget;
+use crate::util::errors::CargoResult;
+use crate::util::machine_message;
+use crate::workspace::manifest::TargetSourcePath;
+use crate::workspace::{PackageId, Target};
+
+static ACTIVE: AtomicU8 = AtomicU8::new(0);
+
+pub fn active() -> bool {
+    match ACTIVE.load(Ordering::Relaxed) {
+        1 => true,
+        2 => false,
+        _ => {
+            #[allow(clippy::disallowed_methods)]
+            let on = std::env::var_os(rp::PLAN_ENV).is_some();
+            ACTIVE.store(if on { 1 } else { 2 }, Ordering::Relaxed);
+            on
+        }
+    }
+}
+
+#[derive(Default)]
+struct State {
+    index: HashMap<usize, u32>,
+    units: Vec<Option<rp::Unit>>,
+    roots: Vec<u32>,
+    steps: Vec<rp::Step>,
+    global: Option<Global>,
+}
+
+struct Global {
+    ws_root: String,
+    cwd: String,
+    target_dir: String,
+    build_dir: String,
+    host: String,
+    finished: String,
+    message_format: rp::MessageFormat,
+    verbosity: rp::Verbosity,
+    extra_verbose: bool,
+    keep_going: bool,
+    deny_warnings: bool,
+}
+
+fn state() -> &'static Mutex<State> {
+    static S: OnceLock<Mutex<State>> = OnceLock::new();
+    S.get_or_init(Default::default)
+}
+
+thread_local! {
+    static CURRENT: Cell<u32> = const { Cell::new(u32::MAX) };
+}
+
+fn s(p: impl AsRef<OsStr>) -> CargoResult<String> {
+    p.as_ref()
+        .to_str()
+        .map(|s| s.to_string())
+        .ok_or_else(|| anyhow::format_err!("rargo: non-UTF-8 value `{}`", p.as_ref().to_string_lossy()))
+}
+
+fn cmd_of(p: &ProcessBuilder) -> CargoResult<rp::Cmd> {
+    let mut env = Vec::new();
+    for (k, v) in p.get_envs() {
+        env.push((
+            k.clone(),
+            match v {
+                Some(v) => Some(s(v)?),
+                None => None,
+            },
+        ));
+    }
+    Ok(rp::Cmd {
+        program: s(p.get_program())?,
+        args: p.get_args().map(s).collect::<CargoResult<_>>()?,
+        env,
+        cwd: p.get_cwd().map(s).transpose()?,
+    })
+}
+
+fn index_of(st: &mut State, unit: &Unit) -> u32 {
+    if let Some(i) = st.index.get(&unit.rargo_key()) {
+        return *i;
+    }
+    let i = st.units.len() as u32;
+    st.units.push(None);
+    st.index.insert(unit.rargo_key(), i);
+    i
+}
+
+fn verbosity(v: Verbosity) -> rp::Verbosity {
+    match v {
+        Verbosity::Verbose => rp::Verbosity::Verbose,
+        Verbosity::Normal => rp::Verbosity::Normal,
+        Verbosity::Quiet => rp::Verbosity::Quiet,
+    }
+}
+
+pub fn record_global(build_runner: &BuildRunner<'_, '_>) -> CargoResult<()> {
+    let bcx: &BuildContext<'_, '_> = build_runner.bcx;
+    let gctx = bcx.gctx;
+    let profile_name = bcx.build_config.requested_profile;
+    let profile = bcx.profiles.base_profile();
+    let mut opt_type = String::from(if profile.opt_level.as_str() == "0" {
+        "unoptimized"
+    } else {
+        "optimized"
+    });
+    if profile.debuginfo.is_turned_on() {
+        opt_type += " + debuginfo";
+    }
+    let message_format = match bcx.build_config.message_format {
+        MessageFormat::Human => rp::MessageFormat::Human,
+        MessageFormat::Short => rp::MessageFormat::Short,
+        MessageFormat::Json { render_diagnostics, short, ansi } => {
+            rp::MessageFormat::Json { render_diagnostics, short, ansi }
+        }
+    };
+    let g = Global {
+        ws_root: s(bcx.ws.root())?,
+        cwd: s(gctx.cwd())?,
+        target_dir: s(bcx.ws.target_dir().into_path_unlocked())?,
+        build_dir: s(bcx.ws.build_dir().into_path_unlocked())?,
+        host: bcx.host_triple().to_string(),
+        finished: format!("`{profile_name}` profile [{opt_type}] target(s) in "),
+        message_format,
+        verbosity: verbosity(gctx.shell().verbosity()),
+        extra_verbose: gctx.extra_verbose(),
+        keep_going: bcx.build_config.keep_going,
+        deny_warnings: gctx.warning_handling()? == crate::context::WarningHandling::Deny,
+    };
+    let mut st = state().lock().unwrap();
+    st.global = Some(g);
+    for root in &bcx.roots {
+        let i = index_of(&mut st, root);
+        st.roots.push(i);
+    }
+    Ok(())
+}
+
+pub fn record_unit(build_runner: &mut BuildRunner<'_, '_>, unit: &Unit) -> CargoResult<u32> {
+    let bcx = build_runner.bcx;
+    let gctx = bcx.gctx;
+
+    let kind = if unit.mode.is_run_custom_build() {
+        rp::UnitKind::RunScript
+    } else if unit.mode.is_doc_test() {
+        rp::UnitKind::Noop
+    } else if unit.mode.is_doc() || unit.mode.is_doc_scrape() {
+        rp::UnitKind::Doc
+    } else {
+        rp::UnitKind::Compile
+    };
+    let verb = if unit.mode.is_run_custom_build() {
+        rp::Verb::Compiling
+    } else if unit.mode.is_doc() {
+        rp::Verb::Documenting
+    } else if unit.mode.is_doc_test() {
+        rp::Verb::Silent
+    } else if unit.mode.is_doc_scrape() {
+        rp::Verb::Scraping
+    } else if unit.mode.is_check() {
+        rp::Verb::Checking
+    } else {
+        rp::Verb::Compiling
+    };
+
+    let mut outputs = Vec::new();
+    if !unit.mode.is_run_custom_build() && !unit.mode.is_doc_test() {
+        for o in build_runner.outputs(unit)?.iter() {
+            outputs.push(rp::OutFile {
+                path: s(&o.path)?,
+                hardlink: o.hardlink.as_ref().map(s).transpose()?,
+                export_path: o.export_path.as_ref().map(s).transpose()?,
+                flavor: format!("{:?}", o.flavor),
+            });
+        }
+    }
+
+    let fix_hint = if unit.is_local() && !unit.target.is_custom_build() {
+        let mut args = format!("{} -p {}", unit.target.description_named(), unit.pkg.name());
+        if unit.mode.is_rustc_test() && !(unit.target.is_test() || unit.target.is_bench()) {
+            args.push_str(" --tests");
+        }
+        Some(args)
+    } else {
+        None
+    };
+
+    let mut target = Target::clone(&unit.target);
+    if let TargetSourcePath::Metabuild = target.src_path() {
+        let path = unit.pkg.manifest().metabuild_path(bcx.ws.build_dir());
+        target.set_src_path(TargetSourcePath::Path(path));
+    }
+    let debuginfo = match unit.profile.debuginfo.into_inner() {
+        TomlDebugInfo::None => machine_message::ArtifactDebuginfo::Int(0),
+        TomlDebugInfo::Limited => machine_message::ArtifactDebuginfo::Int(1),
+        TomlDebugInfo::Full => machine_message::ArtifactDebuginfo::Int(2),
+        TomlDebugInfo::LineDirectivesOnly => machine_message::ArtifactDebuginfo::Named("line-directives-only"),
+        TomlDebugInfo::LineTablesOnly => machine_message::ArtifactDebuginfo::Named("line-tables-only"),
+    };
+    let art_profile = machine_message::ArtifactProfile {
+        opt_level: unit.profile.opt_level.as_str(),
+        debuginfo: Some(debuginfo),
+        debug_assertions: unit.profile.debug_assertions,
+        overflow_checks: unit.profile.overflow_checks,
+        test: unit.mode.is_any_test(),
+    };
+
+    let script = if unit.mode.is_run_custom_build() {
+        let meta = build_runner.get_run_build_script_metadata(unit);
+        let overridden = build_runner.build_script_outputs.lock().unwrap().get(meta).is_some();
+        if overridden {
+            None
+        } else {
+            let out_dir = if gctx.cli_unstable().build_dir_new_layout {
+                build_runner.files().out_dir_new_layout(unit)
+            } else {
+                build_runner.files().build_script_out_dir(unit)
+            };
+            let run_dir = build_runner.files().build_script_run_dir(unit);
+            Some(rp::Script {
+                meta: meta.to_string(),
+                out_dir: s(out_dir)?,
+                run_dir: s(run_dir)?,
+                library_name: unit.pkg.library().map(|t| t.crate_name()),
+                pkg_descr: unit.pkg.to_string(),
+                nightly_features_allowed: gctx.nightly_features_allowed,
+                targets: unit.pkg.targets().iter().map(target_brief).collect(),
+                msrv: unit.pkg.rust_version().map(|v| v.to_string()),
+                links: unit.pkg.manifest().links().map(|l| l.to_string()),
+                vv_prefix: format!("[{} {}] ", unit.pkg.package_id().name(), unit.pkg.package_id().version()),
+            })
+        }
+    } else {
+        None
+    };
+    let kind = if unit.mode.is_run_custom_build() && script.is_none() { rp::UnitKind::Noop } else { kind };
+
+    let script_metas = build_runner
+        .find_build_script_metadatas(unit)
+        .unwrap_or_default()
+        .iter()
+        .map(|m| m.to_string())
+        .collect();
+    let executable = build_runner.get_executable(unit)?.map(s).transpose()?;
+    let rmeta_early = build_runner.rmeta_required(unit);
+    let scrape_can_fail = bcx.unit_can_fail_for_docscraping(unit);
+    let deps: Vec<(Unit, bool)> = build_runner
+        .unit_deps(unit)
+        .iter()
+        .map(|d| (d.unit.clone(), build_runner.only_requires_rmeta(unit, &d.unit)))
+        .collect();
+
+    let mut st = state().lock().unwrap();
+    let idx = index_of(&mut st, unit);
+    let deps = deps
+        .into_iter()
+        .map(|(u, only_rmeta)| rp::Dep { unit: index_of(&mut st, &u), only_rmeta })
+        .collect();
+    let rec = rp::Unit {
+        kind,
+        cmd: None,
+        deps,
+        outputs,
+        rmeta_early,
+        pkg: unit.pkg.to_string(),
+        pkg_id: format!("{:?}", unit.pkg.package_id()),
+        pkg_name: unit.pkg.name().to_string(),
+        pkg_version: unit.pkg.version().to_string(),
+        desc: super::descriptive_pkg_name(&unit.pkg.name(), &unit.target, &unit.mode),
+        verb,
+        is_local: unit.is_local(),
+        show_warnings: unit.show_warnings(gctx),
+        fix_hint,
+        pkg_spec: unit.pkg.package_id().to_spec().to_string(),
+        manifest_path: s(unit.pkg.manifest_path())?,
+        target_json: serde_json::to_string(&target)?,
+        profile_json: serde_json::to_string(&art_profile)?,
+        features: unit.features.iter().map(|f| f.to_string()).collect(),
+        executable,
+        script,
+        script_metas,
+        scrape_can_fail,
+    };
+    st.units[idx as usize] = Some(rec);
+    Ok(idx)
+}
