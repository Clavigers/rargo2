+pub fn convert_output(o: &super::BuildOutput) -> rp::BuildOutput {
+    rp::BuildOutput {
+        library_paths: o
+            .library_paths
+            .iter()
+            .map(|p| {
+                (matches!(p, super::LibraryPath::CargoArtifact(_)), p.as_ref().to_string_lossy().into_owned())
+            })
+            .collect(),
+        library_links: o.library_links.clone(),
+        linker_args: o
+            .linker_args
+            .iter()
+            .map(|(t, a)| {
+                let t = match t {
+                    LinkArgTarget::All => rp::LinkArgTarget::Kind(rp::LinkArgKind::All),
+                    LinkArgTarget::Cdylib => rp::LinkArgTarget::Kind(rp::LinkArgKind::Cdylib),
+                    LinkArgTarget::Bin => rp::LinkArgTarget::Kind(rp::LinkArgKind::Bin),
+                    LinkArgTarget::Test => rp::LinkArgTarget::Kind(rp::LinkArgKind::Test),
+                    LinkArgTarget::Bench => rp::LinkArgTarget::Kind(rp::LinkArgKind::Bench),
+                    LinkArgTarget::Example => rp::LinkArgTarget::Kind(rp::LinkArgKind::Example),
+                    LinkArgTarget::SingleBin(n) => rp::LinkArgTarget::SingleBin(n.clone()),
+                };
+                (t, a.clone())
+            })
+            .collect(),
+        cfgs: o.cfgs.clone(),
+        check_cfgs: o.check_cfgs.clone(),
+        env: o.env.clone(),
+        metadata: o.metadata.clone(),
+        rerun_if_changed: o.rerun_if_changed.iter().map(|p| p.to_string_lossy().into_owned()).collect(),
+        rerun_if_env_changed: o.rerun_if_env_changed.clone(),
+        log_messages: o
+            .log_messages
+            .iter()
+            .map(|(sev, m)| (matches!(sev, super::custom_build::Severity::Error), m.clone()))
+            .collect(),
+    }
+}
