+pub fn parse_service() -> ! {
+    use crate::workspace::Edition;
+    use crate::workspace::manifest::Target as T;
+    use std::io::{Read, Write};
+    let stdin = std::io::stdin();
+    let stdout = std::io::stdout();
+    let mut inp = stdin.lock();
+    let mut out = stdout.lock();
+    loop {
+        let mut len = [0u8; 4];
+        if inp.read_exact(&mut len).is_err() {
+            std::process::exit(0);
+        }
+        let mut buf = vec![0u8; u32::from_le_bytes(len) as usize];
+        if inp.read_exact(&mut buf).is_err() {
+            std::process::exit(1);
+        }
+        let resp: rp::ParseResp = (|| {
+            let req: rp::ParseReq = rp::decode(&buf)?;
+            let sc = &req.script;
+            let ed = Edition::Edition2021;
+            let mut targets = Vec::new();
+            for t in &sc.targets {
+                let p = std::path::PathBuf::from("/nonexistent.rs");
+                if t.is_bin {
+                    targets.push(T::bin_target(&t.name, None, p, None, ed));
+                } else if t.is_cdylib {
+                    targets.push(T::lib_target(&t.name, vec![super::CrateType::Cdylib], p, ed));
+                } else if t.is_test {
+                    targets.push(T::test_target(&t.name, p, None, ed));
+                } else if t.is_bench {
+                    targets.push(T::bench_target(&t.name, p, None, ed));
+                } else if t.is_exe_example {
+                    targets.push(T::example_target(&t.name, vec![], p, None, ed));
+                }
+            }
+            let msrv = match &sc.msrv {
+                Some(v) => Some(v.parse().map_err(|e| format!("bad rust-version: {e}"))?),
+                None => None,
+            };
+            let out_dir = Path::new(&sc.out_dir);
+            let parsed = super::BuildOutput::parse(
+                &req.stdout,
+                sc.library_name.clone(),
+                &sc.pkg_descr,
+                out_dir,
+                out_dir,
+                sc.nightly_features_allowed,
+                &targets,
+                &msrv,
+            )
+            .map_err(|e| format!("{e:#}"))?;
+            Ok(convert_output(&parsed))
+        })();
+        let bytes = rp::encode(&resp);
+        if out.write_all(&(bytes.len() as u32).to_le_bytes()).is_err()
+            || out.write_all(&bytes).is_err()
+            || out.flush().is_err()
+        {
+            std::process::exit(1);
+        }
+    }
+}
