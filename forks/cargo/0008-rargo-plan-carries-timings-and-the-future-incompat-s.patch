         pkg_spec: unit.pkg.package_id().to_spec().to_string(),
@@ -643,6 +650,9 @@ pub fn finish() -> CargoResult<()> {
         verbosity: g.verbosity,
         extra_verbose: g.extra_verbose,
         keep_going: g.keep_going,
+        future_incompat_report: g.future_incompat_report,
+        future_incompat_display: g.future_incompat_display,
+        timings: g.timings,
         deny_warnings: g.deny_warnings,
         no_fail_fast,
         nocapture,
