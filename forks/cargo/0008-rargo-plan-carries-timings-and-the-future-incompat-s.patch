+        future_incompat_display: gctx.future_incompat_config().map(|c| c.should_display_message()).unwrap_or(true),
+        timings: bcx.build_config.timing_report,
         deny_warnings: gctx.warning_handling()? == crate::context::WarningHandling::Deny,
         rustc_fork: bcx
             .target_data
@@ -300,6 +306,7 @@ pub fn record_unit(build_runner: &mut BuildRunner<'_, '_>, unit: &Unit) -> Cargo
         desc: super::descriptive_pkg_name(&unit.pkg.name(), &unit.target, &unit.mode),
         verb,
         is_local: unit.is_local(),
