Subject: [PATCH 8/8] rargo: plan carries --timings and the future-incompat
 settings; no timing report while planning

---
 src/compiler/rargo.rs       | 10 ++++++++++
 src/compiler/timings/mod.rs |  1 +
 2 files changed, 11 insertions(+)

diff --git a/src/compiler/rargo.rs b/src/compiler/rargo.rs
index 4ad78a5..c22f5ec 100644
--- a/src/compiler/rargo.rs
+++ b/src/compiler/rargo.rs
@@ -59,6 +59,9 @@ struct Global {
     deny_warnings: bool,
     rustc_fork: bool,
     dep_info_basedir: Option<String>,
+    future_incompat_report: bool,
+    future_incompat_display: bool,
+    timings: bool,
 }
 
 fn state() -> &'static Mutex<State> {
@@ -145,6 +148,9 @@ pub fn record_global(build_runner: &BuildRunner<'_, '_>) -> CargoResult<()> {
         verbosity: verbosity(gctx.shell().verbosity()),
