From 488c0fec8d5aeff1072ad553f3d2f51c769b274e Mon Sep 17 00:00:00 2001
From: rargo <rargo@localhost>
Date: Mon, 23 Nov 2026 10:25:49 +0100
Subject: [PATCH 8/8] rargo: plan carries --timings and the future-incompat
 settings; no timing report while planning

---
 src/compiler/rargo.rs       | 10 ++++++++++
 src/compiler/timings/mod.rs |  3 +++
 2 files changed, 13 insertions(+)

diff --git a/src/compiler/rargo.rs b/src/compiler/rargo.rs
index 33163167f..c53de4866 100644
--- a/src/compiler/rargo.rs
+++ b/src/compiler/rargo.rs
@@ -71,6 +71,9 @@ struct Global {
     deny_warnings: bool,
     rustc_fork: bool,
     dep_info_basedir: Option<String>,
+    future_incompat_report: bool,
+    future_incompat_display: bool,
+    timings: bool,
 }
 
 fn state() -> &'static Mutex<State> {
@@ -158,6 +161,9 @@ pub fn record_global(build_runner: &BuildRunner<'_, '_>) -> CargoResult<()> {
         verbosity: verbosity(gctx.shell().verbosity()),
         extra_verbose: gctx.extra_verbose(),
         keep_going: bcx.build_config.keep_going,
+        future_incompat_report: bcx.build_config.future_incompat_report,
+        future_incompat_display: gctx.future_incompat_config().map(|c| c.should_display_message()).unwrap_or(true),
+        timings: bcx.build_config.timing_report,
         deny_warnings: gctx.warning_handling()? == crate::context::WarningHandling::Deny,
         rustc_fork: bcx
             .target_data
@@ -315,6 +321,7 @@ pub fn record_unit(build_runner: &mut BuildRunner<'_, '_>, unit: &Unit) -> Cargo
         desc: super::descriptive_pkg_name(&unit.pkg.name(), &unit.target, &unit.mode),
         verb,
         is_local: unit.is_local(),
+        repository: unit.pkg.manifest().metadata().repository.clone(),
         show_warnings: unit.show_warnings(gctx),
         fix_hint,
         pkg_spec: unit.pkg.package_id().to_spec().to_string(),
@@ -690,6 +697,9 @@ pub fn finish() -> CargoResult<()> {
         verbosity: g.verbosity,
         extra_verbose: g.extra_verbose,
         keep_going: g.keep_going,
+        future_incompat_report: g.future_incompat_report,
+        future_incompat_display: g.future_incompat_display,
+        timings: g.timings,
         deny_warnings: g.deny_warnings,
         no_fail_fast,
         nocapture,
diff --git a/src/compiler/timings/mod.rs b/src/compiler/timings/mod.rs
index 4befbc61a..8229b24b1 100644
--- a/src/compiler/timings/mod.rs
+++ b/src/compiler/timings/mod.rs
@@ -281,7 +281,10 @@ impl<'gctx> Timings<'gctx> {
         build_runner: &BuildRunner<'_, '_>,
         error: &Option<anyhow::Error>,
     ) -> CargoResult<()> {
+        // When planning for rargo nothing was compiled here: the server
+        // that runs the plan writes the report.
         if let Some(logger) = build_runner.bcx.logger
+            && !crate::compiler::rargo::active()
             && let Some(logs) = logger.get_logs()
         {
             let timings_path = build_runner
