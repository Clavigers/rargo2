 //! Dep-graph indices are bulk allocated to threads inside `LocalEncoderState`. Having threads
 //! own these indices helps avoid races when they are conditionally used when marking nodes green.
 //! It also reduces congestion on the shared index count.
+//!
+//! A node that is in the previous graph keeps its previous index, and a new node gets an index
+//! above the previous graph's index space, so a small change to the graph is a small change to
+//! this file: the records and edge lists of the unchanged nodes stay byte for byte the same.
+//! The indices of nodes that are gone stay unused. When more than half the index space is unused,
+//! the session numbers every node afresh instead, so the index space stays bounded.
 
 use std::cell::RefCell;
 use std::cmp::max;
@@ -628,8 +634,16 @@ struct LocalEncoderResult {
     kind_stats: Vec<u32>,
 }
 
+/// The indices that `DepGraph::new` gives its two fixed nodes (`SINGLETON_ZERO_DEPS_ANON_NODE`
+/// and `FOREVER_RED_NODE`) in every session.
+const RESERVED_INDICES: u32 = 2;
+
 struct EncoderState {
     next_node_index: AtomicU64,
+    /// Whether nodes of the previous graph keep their indices in this session.
+    keep_indices: bool,
+    /// The lowest index given to a node that is new in this session.
+    new_index_base: u32,
     previous: Arc<SerializedDepGraph>,
     file: Lock<Option<FileEncoder<'static>>>,
     local: WorkerLocal<RefCell<LocalEncoderState>>,
@@ -642,9 +656,17 @@ fn new(
         record_stats: bool,
         previous: Arc<SerializedDepGraph>,
     ) -> Self {
+        // Keeping indices leaves the indices of the nodes that are gone unused; once they are
+        // most of the index space, this session numbers its nodes afresh.
+        let prev_len = previous.index_space_len();
+        let keep_indices = prev_len <= 2 * previous.live_node_count() + 4096;
+        let new_index_base =
+            if keep_indices { max(prev_len as u32, RESERVED_INDICES) } else { RESERVED_INDICES };
         Self {
             previous,
-            next_node_index: AtomicU64::new(0),
+            next_node_index: AtomicU64::new(new_index_base as u64),
+            keep_indices,
+            new_index_base,
             stats: record_stats.then(|| Lock::new(FxHashMap::default())),
             file: Lock::new(Some(encoder)),
             local: WorkerLocal::new(|_| {
@@ -688,6 +710,32 @@ fn bump_index(&self, local: &mut LocalEncoderState) {
         local.node_count += 1;
     }
 
+    /// The index for a node of the previous graph: its previous index, or a new one when this
+    /// session does not keep indices. The second value says which; pass it to `claim_index`
+    /// once the node is encoded.
+    #[inline]
+    fn index_for_prev(
+        &self,
+        prev_index: SerializedDepNodeIndex,
+        local: &mut LocalEncoderState,
+    ) -> (DepNodeIndex, bool) {
+        if self.keep_indices && prev_index.as_u32() >= RESERVED_INDICES {
+            (DepNodeIndex::from_u32(prev_index.as_u32()), true)
+        } else {
+            (self.next_index(local), false)
+        }
+    }
+
+    /// Marks an index returned by `index_for_prev` as used.
+    #[inline]
+    fn claim_index(&self, kept: bool, local: &mut LocalEncoderState) {
+        if kept {
+            local.node_count += 1;
+        } else {
+            self.bump_index(local);
+        }
+    }
+
     #[inline]
     fn record(
         &self,
@@ -794,7 +842,9 @@ fn finish(&self, profiler: &SelfProfilerRef, current: &CurrentDepGraph) -> FileE
 
         let mut kind_stats: Vec<u32> = iter::repeat_n(0, DepKind::NUM_VARIANTS).collect();
 
-        let mut node_max = 0;
+        // Nodes of the previous graph that kept their indices may use any index below
+        // `new_index_base`, and the reserved ones are always used.
+        let mut node_max = self.new_index_base;
         let mut node_count = 0;
         let mut edge_count = 0;
 
@@ -919,6 +969,23 @@ pub(crate) fn retained_dep_graph(&self) -> Option<RetainedDepGraph> {
         self.retained_graph.as_ref().map(|retained_graph| retained_graph.lock().clone())
     }
 
+    /// Encodes one of the nodes that have a fixed index in every session
+    /// (below `RESERVED_INDICES`).
+    pub(crate) fn send_reserved(
+        &self,
+        index: DepNodeIndex,
+        node: DepNode,
+        value_fingerprint: Fingerprint,
+        edges: &[DepNodeIndex],
+    ) -> DepNodeIndex {
+        assert!(index.as_u32() < RESERVED_INDICES);
+        let node = NodeInfo { node, value_fingerprint, edges };
+        let mut local = self.status.local.borrow_mut();
+        local.node_count += 1;
+        self.status.encode_node(index, &node, &self.retained_graph, &mut *local);
+        index
+    }
+
     /// Encodes a node that does not exists in the previous graph.
     pub(crate) fn send_new(
