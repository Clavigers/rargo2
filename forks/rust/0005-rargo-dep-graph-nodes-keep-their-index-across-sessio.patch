From ceb02fd2528dfebecb4c658c7c02f04dbfc9b179 Mon Sep 17 00:00:00 2001
From: rargo <noreply@rargo.invalid>
Date: Wed, 25 Nov 2026 03:44:38 +0100
Subject: [PATCH 5/5] rargo: dep-graph nodes keep their index across sessions

---
 compiler/rustc_middle/src/dep_graph/graph.rs  | 19 +++---
 .../rustc_middle/src/dep_graph/serialized.rs  | 59 +++++++++++++++++--
 2 files changed, 64 insertions(+), 14 deletions(-)

diff --git a/compiler/rustc_middle/src/dep_graph/graph.rs b/compiler/rustc_middle/src/dep_graph/graph.rs
index dcb5775..f39efc8 100644
--- a/compiler/rustc_middle/src/dep_graph/graph.rs
+++ b/compiler/rustc_middle/src/dep_graph/graph.rs
@@ -186,22 +186,18 @@ impl DepGraph {
         let colors = DepNodeColorMap::new(prev_index_space_len);
 
         // Instantiate a node with zero dependencies only once for anonymous queries.
-        let _green_node_index = current.alloc_new_node(
+        current.alloc_reserved_node(
+            DepNodeIndex::SINGLETON_ZERO_DEPS_ANON_NODE,
             DepNode { kind: DepKind::AnonZeroDeps, key_fingerprint: current.anon_id_seed.into() },
-            &[],
-            Fingerprint::ZERO,
         );
-        assert_eq!(_green_node_index, DepNodeIndex::SINGLETON_ZERO_DEPS_ANON_NODE);
 
         // Create a single always-red node, with no dependencies of its own.
         // Other nodes can use the always-red node as a fake dependency, to
         // ensure that their dependency list will never be all-green.
-        let red_node_index = current.alloc_new_node(
+        current.alloc_reserved_node(
+            DepNodeIndex::FOREVER_RED_NODE,
             DepNode { kind: DepKind::Red, key_fingerprint: Fingerprint::ZERO.into() },
-            &[],
-            Fingerprint::ZERO,
         );
-        assert_eq!(red_node_index, DepNodeIndex::FOREVER_RED_NODE);
         if prev_index_space_len > 0 {
             let prev_index =
                 const { SerializedDepNodeIndex::from_u32(DepNodeIndex::FOREVER_RED_NODE.as_u32()) };
@@ -1266,6 +1262,13 @@ impl CurrentDepGraph {
         assert_eq!(prior_value_fingerprint, value_fingerprint, "Unstable fingerprints for {key:?}");
     }
 
+    fn alloc_reserved_node(&self, index: DepNodeIndex, key: DepNode) {
+        self.encoder.send_reserved(index, key, Fingerprint::ZERO, &[]);
+
+        #[cfg(debug_assertions)]
+        self.record_edge(index, key, Fingerprint::ZERO);
+    }
+
     /// Writes the node to the current dep-graph and allocates a `DepNodeIndex` for it.
     /// Assumes that this is a node that has no equivalent in the previous dep-graph.
     #[inline(always)]
diff --git a/compiler/rustc_middle/src/dep_graph/serialized.rs b/compiler/rustc_middle/src/dep_graph/serialized.rs
index 1c476fc..b35b1d1 100644
--- a/compiler/rustc_middle/src/dep_graph/serialized.rs
+++ b/compiler/rustc_middle/src/dep_graph/serialized.rs
@@ -628,8 +628,12 @@ struct LocalEncoderResult {
     kind_stats: Vec<u32>,
 }
 
+const RESERVED_INDICES: u32 = 2;
+
 struct EncoderState {
     next_node_index: AtomicU64,
+    keep_indices: bool,
+    new_index_base: u32,
     previous: Arc<SerializedDepGraph>,
     file: Lock<Option<FileEncoder<'static>>>,
     local: WorkerLocal<RefCell<LocalEncoderState>>,
@@ -642,9 +646,15 @@ impl EncoderState {
         record_stats: bool,
         previous: Arc<SerializedDepGraph>,
     ) -> Self {
+        let prev_len = previous.index_space_len();
+        let keep_indices = prev_len <= 2 * previous.live_node_count() + 4096;
+        let new_index_base =
+            if keep_indices { max(prev_len as u32, RESERVED_INDICES) } else { RESERVED_INDICES };
         Self {
             previous,
-            next_node_index: AtomicU64::new(0),
+            next_node_index: AtomicU64::new(new_index_base as u64),
+            keep_indices,
+            new_index_base,
             stats: record_stats.then(|| Lock::new(FxHashMap::default())),
             file: Lock::new(Some(encoder)),
             local: WorkerLocal::new(|_| {
@@ -688,6 +698,28 @@ impl EncoderState {
         local.node_count += 1;
     }
 
+    #[inline]
+    fn index_for_prev(
+        &self,
+        prev_index: SerializedDepNodeIndex,
+        local: &mut LocalEncoderState,
+    ) -> (DepNodeIndex, bool) {
+        if self.keep_indices && prev_index.as_u32() >= RESERVED_INDICES {
+            (DepNodeIndex::from_u32(prev_index.as_u32()), true)
+        } else {
+            (self.next_index(local), false)
+        }
+    }
+
+    #[inline]
+    fn claim_index(&self, kept: bool, local: &mut LocalEncoderState) {
+        if kept {
+            local.node_count += 1;
+        } else {
+            self.bump_index(local);
+        }
+    }
+
     #[inline]
     fn record(
         &self,
@@ -794,7 +826,7 @@ impl EncoderState {
 
         let mut kind_stats: Vec<u32> = iter::repeat_n(0, DepKind::NUM_VARIANTS).collect();
 
-        let mut node_max = 0;
+        let mut node_max = self.new_index_base;
         let mut node_count = 0;
         let mut edge_count = 0;
 
@@ -919,6 +951,21 @@ impl GraphEncoder {
         self.retained_graph.as_ref().map(|retained_graph| retained_graph.lock().clone())
     }
 
+    pub(crate) fn send_reserved(
+        &self,
+        index: DepNodeIndex,
+        node: DepNode,
+        value_fingerprint: Fingerprint,
+        edges: &[DepNodeIndex],
+    ) -> DepNodeIndex {
+        assert!(index.as_u32() < RESERVED_INDICES);
+        let node = NodeInfo { node, value_fingerprint, edges };
+        let mut local = self.status.local.borrow_mut();
+        local.node_count += 1;
+        self.status.encode_node(index, &node, &self.retained_graph, &mut *local);
+        index
+    }
+
     /// Encodes a node that does not exists in the previous graph.
     pub(crate) fn send_new(
         &self,
@@ -952,7 +999,7 @@ impl GraphEncoder {
 
         let mut local = self.status.local.borrow_mut();
 
-        let index = self.status.next_index(&mut *local);
+        let (index, kept) = self.status.index_for_prev(prev_index, &mut *local);
         let color = if is_green { DesiredColor::Green { index } } else { DesiredColor::Red };
 
         // Use `try_set_color` to avoid racing when `send_promoted` is called concurrently
@@ -963,7 +1010,7 @@ impl GraphEncoder {
             TrySetColorResult::AlreadyGreen { index } => return index,
         }
 
-        self.status.bump_index(&mut *local);
+        self.status.claim_index(kept, &mut *local);
         self.status.encode_node(index, &node, &self.retained_graph, &mut *local);
         index
     }
@@ -984,13 +1031,13 @@ impl GraphEncoder {
         let _prof_timer = self.profiler.generic_activity("incr_comp_encode_dep_graph");
 
         let mut local = self.status.local.borrow_mut();
-        let index = self.status.next_index(&mut *local);
+        let (index, kept) = self.status.index_for_prev(prev_index, &mut *local);
 
         // Use `try_set_color` to avoid racing when `send_promoted` or `send_and_color`
         // is called concurrently on the same index.
         match colors.try_set_color(prev_index, DesiredColor::Green { index }) {
             TrySetColorResult::Success => {
-                self.status.bump_index(&mut *local);
+                self.status.claim_index(kept, &mut *local);
                 self.status.encode_promoted_node(
                     index,
                     prev_index,
