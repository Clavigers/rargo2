 compiler/rustc_metadata/src/rmeta/decoder.rs |   5 +-
 compiler/rustc_metadata/src/rmeta/encoder.rs | 145 +++++++++++++++++--
 compiler/rustc_metadata/src/rmeta/mod.rs     |   7 +-
 compiler/rustc_span/src/lib.rs               |   5 +
