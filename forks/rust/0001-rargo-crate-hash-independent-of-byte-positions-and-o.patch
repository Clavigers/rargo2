 use crate::eii::EiiMapEncodedKeyValue;
 use crate::rmeta::*;
 
+/// rargo: byte ranges of the metadata file that do not take part in the crate hash.
+///
+/// Byte positions of spans and the source-file tables that turn positions into lines change
+/// whenever any earlier line of a source file changes length, even though nothing a dependent
+/// crate can observe (line and column numbers) has changed. Those bytes are still written, so a
+/// dependent decodes correct spans, but they are left out of the hash; what they mean (file,
+/// line, column) is hashed separately in `span_hasher`.
+#[derive(Default)]
+struct HashSkips {
+    /// Number of bytes handed to the flush hook so far.
+    flushed: usize,
+    /// Ranges `[start, end)` in file offsets, in increasing order.
+    ranges: std::collections::VecDeque<(usize, usize)>,
+}
+
 pub(super) struct EncodeContext<'a, 'tcx> {
     opaque: FileEncoder<'a>,
     metadata_hasher: Arc<Mutex<XxHash3_128>>,
+    hash_skips: Arc<Mutex<HashSkips>>,
+    /// Digest of the position-independent meaning of every encoded span.
+    span_hasher: XxHash3_128,
     tcx: TyCtxt<'tcx>,
     feat: &'tcx rustc_feature::Features,
     tables: TableBuilders,
@@ -343,22 +360,43 @@ fn encode(&self, s: &mut EncodeContext<'a, 'tcx>) {
             (SpanKind::Local, metadata_index)
         };
 
-        // Encode the start position relative to the file start, so we profit more from the
-        // variable-length integer encoding.
         let lo = self.lo - source_file.start_pos;
-
-        // Encode length which is usually less than span.hi and profits more
-        // from the variable-length integer encoding that we use.
         let len = self.hi - self.lo;
 
-        let tag = SpanTag::new(kind, ctxt, len.0 as usize);
+        // rargo: what a dependent crate can observe of this span is its file, lines and
+        // columns. That goes into the crate hash; the byte offsets below do not.
+        let (line_col_lo, line_col_hi) = {
+            let line_col = |pos: rustc_span::BytePos| {
+                let rel = source_file.relative_position(pos);
+                match source_file.lookup_line(rel) {
+                    Some(line) => (line as u32, rel.0 - source_file.lines()[line].0),
+                    None => (u32::MAX, rel.0),
+                }
+            };
+            (line_col(self.lo), line_col(self.hi))
+        };
+        let stable_file_id = source_file.stable_id;
+
+        // The tag never carries the length inline, and offset and length are fixed-width, so
+        // that a span whose byte position changed occupies exactly the same bytes as before
+        // and nothing after it moves.
+        let tag = SpanTag::new(kind, ctxt, usize::MAX);
         tag.encode(s);
         if tag.context().is_none() {
             ctxt.encode(s);
         }
-        lo.encode(s);
-        if tag.length().is_none() {
-            len.encode(s);
+        let start = s.position();
+        s.emit_raw_bytes(&lo.0.to_le_bytes());
+        s.emit_raw_bytes(&len.0.to_le_bytes());
+        s.skip_in_hash(start, s.position());
+        {
+            let mut buf = [0u8; 32];
+            buf[..16].copy_from_slice(&stable_file_id.to_le_bytes());
+            buf[16..20].copy_from_slice(&line_col_lo.0.to_le_bytes());
+            buf[20..24].copy_from_slice(&line_col_lo.1.to_le_bytes());
+            buf[24..28].copy_from_slice(&line_col_hi.0.to_le_bytes());
+            buf[28..32].copy_from_slice(&line_col_hi.1.to_le_bytes());
+            s.span_hasher.write(&buf);
         }
 
         // Encode the index of the `SourceFile` for the span, in order to make decoding faster.
@@ -380,6 +418,15 @@ fn encode(&self, e: &mut EncodeContext<'a, 'tcx>) {
     }
 }
 
+impl<'a, 'tcx> EncodeContext<'a, 'tcx> {
+    /// rargo: excludes the file bytes `[start, end)` from the crate hash.
+    fn skip_in_hash(&mut self, start: usize, end: usize) {
+        if start < end {
+            self.hash_skips.lock().unwrap().ranges.push_back((start, end));
+        }
+    }
+}
+
 impl<'a, 'tcx> TyEncoder<'tcx> for EncodeContext<'a, 'tcx> {
     const CLEAR_CROSS_CRATE: bool = true;
 
@@ -731,11 +778,30 @@ macro_rules! stat {
 
         // Encode source_map. This needs to be done last, because encoding `Span`s tells us which
         // `SourceFiles` we actually need to encode.
-        let source_map = stat!("source-map", || self.encode_source_map());
+        // rargo: the source-file tables (content hashes, line tables) are not part of the
+        // crate hash; the identities of the files are. They are encoded after everything else
+        // that is hashed (the two small tables below used to follow them), so that their size
+        // does not move anything the hash covers.
         let target_modifiers = stat!("target-modifiers", || self.encode_target_modifiers());
         let denied_partial_mitigations = stat!("denied-partial-mitigations", || self
             .encode_enabled_denied_partial_mitigations());
 
+        let source_map = stat!("source-map", || {
+            let files = tcx.sess.source_map().files();
+            if let Some(required) = self.required_source_files.as_ref() {
+                for &idx in required.iter() {
+                    let id = files[idx].stable_id.to_le_bytes();
+                    self.span_hasher.write(&id);
+                }
+            }
+            drop(files);
+            let start = self.position();
+            let table = self.encode_source_map();
+            let end = self.position();
+            self.skip_in_hash(start, end);
+            table
+        });
+
         let root = stat!("crate-root", || {
             let attrs = tcx.hir_krate_attrs();
             self.lazy(CrateRoot {
@@ -802,6 +868,9 @@ macro_rules! stat {
         // `crate_hash` query computes directly without consulting `local_crate_hash`.
         let hash = if tcx.sess.opts.unstable_opts.metadata_crate_hash {
             self.opaque.flush();
+            // rargo: fold in what the spans mean (see `HashSkips`).
+            let spans = self.span_hasher.finish_128().to_le_bytes();
+            self.metadata_hasher.lock().unwrap().write(&spans);
             Svh::new(Fingerprint::from_le_bytes(
                 self.metadata_hasher.lock().unwrap().finish_128().to_le_bytes(),
             ))
@@ -2635,22 +2704,64 @@ fn with_encode_metadata_header(
     if metadata_crate_hash {
         // Fold in inputs that are not part of the encoded metadata bytes, reduced to a single
         // fingerprint via the stable hasher and then mixed into the byte digest.
-        let hir_body_hash = compute_hir_hash(tcx);
+        //
+        // rargo: upstream folds in the hash of the whole HIR here, bodies included, which makes
+        // the crate hash change on every edit and defeats the point of deriving it from the
+        // metadata. Everything a dependent can learn about this crate it learns from the
+        // metadata; the HIR hash was there for items that leave no trace in it, of which
+        // global assembly is the one that exists. Only those items are folded in.
+        let global_asm_hash = tcx
+            .hir_crate_items(())
+            .owners()
+            .filter(|owner| matches!(tcx.def_kind(owner.def_id), DefKind::GlobalAsm))
+            .filter_map(|owner| Some(tcx.lower_to_hir(owner.def_id).as_owner()?.fingerprint()))
+            .reduce(Fingerprint::combine_commutative)
+            .unwrap_or(Fingerprint::ZERO);
         let supplement: Fingerprint = tcx.with_stable_hashing_context(|mut hcx| {
             let mut hasher = StableHasher::new();
             // Add dep_tracking_hash to ensure the SVH changes when any tracked flag changes.
             tcx.sess.opts.dep_tracking_hash(true).stable_hash(&mut hcx, &mut hasher);
-            // Add HIR hash for untracked elements, e.g. DefKind::GlobalAsm.
-            hir_body_hash.stable_hash(&mut hcx, &mut hasher);
+            global_asm_hash.stable_hash(&mut hcx, &mut hasher);
             hasher.finish()
         });
         metadata_hasher.lock().unwrap().write(&supplement.to_le_bytes());
     }
 
-    // Feed every flushed byte into `metadata_hasher` so the SVH covers the entire encoded metadata.
+    // Feed every flushed byte into `metadata_hasher` so the SVH covers the encoded metadata,
+    // except for the ranges registered in `hash_skips` (rargo: byte positions; see `HashSkips`).
+    let hash_skips: Arc<Mutex<HashSkips>> = Arc::default();
     let mut flush_strategy = {
         let metadata_hasher = Arc::clone(&metadata_hasher);
-        move |bytes: &[u8]| metadata_hasher.lock().unwrap().write(bytes)
+        let hash_skips = Arc::clone(&hash_skips);
+        move |bytes: &[u8]| {
+            let mut skips = hash_skips.lock().unwrap();
+            let mut hasher = metadata_hasher.lock().unwrap();
+            let base = skips.flushed;
+            let end = base + bytes.len();
+            let mut off = base;
+            while off < end {
+                match skips.ranges.front().copied() {
+                    Some((a, b)) if a < end => {
+                        if off < a {
+                            hasher.write(&bytes[off - base..a - base]);
+                        }
+                        if b <= end {
+                            skips.ranges.pop_front();
+                            off = off.max(b);
+                        } else {
+                            // The range continues in a later flush.
+                            skips.ranges.front_mut().unwrap().0 = end;
+                            off = end;
+                        }
+                    }
+                    _ => {
+                        hasher.write(&bytes[off - base..]);
+                        off = end;
+                    }
+                }
+            }
+            skips.flushed = end;
+        }
     };
 
     let mut encoder = if metadata_crate_hash {
@@ -2678,6 +2789,8 @@ fn with_encode_metadata_header(
     let mut ecx = EncodeContext {
         opaque: encoder,
         metadata_hasher: Arc::clone(&metadata_hasher),
+        hash_skips,
+        span_hasher: XxHash3_128::new(),
         tcx,
         feat: tcx.features(),
         tables: Default::default(),
