+        let lo = BytePos(u32::from_le_bytes(decoder.read_raw_bytes(4).try_into().unwrap()));
+        let len = BytePos(u32::from_le_bytes(decoder.read_raw_bytes(4).try_into().unwrap()));
         let hi = lo + len;
 
         let tcx = decoder.tcx;
