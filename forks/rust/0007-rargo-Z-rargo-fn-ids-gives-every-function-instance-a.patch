+    pub(crate) fn rargo_finish_fn_ids(&mut self) {
+        let rows = self.rargo_fn_ids.take();
+        if rows.is_empty() {
+            return;
+        }
+        let text = self.const_bytes(&rows);
+        let table = self.define_global(&self.generate_local_symbol_name("rargo_fn_ids"), self.val_ty(text)).unwrap();
+        llvm::set_initializer(table, text);
+        llvm::set_linkage(table, llvm::Linkage::InternalLinkage);
+        llvm::LLVMSetGlobalConstant(table, llvm::TRUE);
+        llvm::set_section(table, c".rargo_fn_ids");
+        set_global_alignment(self, table, Align::ONE);
+        self.add_used_global(table);
+    }
+
     pub(crate) fn rargo_finish_slots(&mut self) {
         const RARGO_SLOT_PAGE: usize = 4096;
         let Some(pending) = self.rargo_slot_array.take() else { return };
