From 5eede15804ae5f6f8f261521c18f49c385374bfb Mon Sep 17 00:00:00 2001
From: sadosystems <noreply@rargo.invalid>
Date: Mon, 23 Nov 2026 02:07:51 +0100
Subject: [PATCH 4/5] rargo: spans into another crate's file are stored as
 lines and columns

---
 compiler/rustc_metadata/src/rmeta/decoder.rs | 26 +++++++++++++++++---
 compiler/rustc_metadata/src/rmeta/encoder.rs | 11 +++++++--
 2 files changed, 32 insertions(+), 5 deletions(-)

diff --git a/compiler/rustc_metadata/src/rmeta/decoder.rs b/compiler/rustc_metadata/src/rmeta/decoder.rs
index 3c03a57..8088db2 100644
--- a/compiler/rustc_metadata/src/rmeta/decoder.rs
+++ b/compiler/rustc_metadata/src/rmeta/decoder.rs
@@ -564,9 +564,12 @@ impl<'a, 'tcx> Decodable<MetadataDecodeContext<'a, 'tcx>> for SpanData {
 
         debug_assert!(tag.kind() == SpanKind::Local || tag.kind() == SpanKind::Foreign);
 
-        let lo = BytePos(u32::from_le_bytes(decoder.read_raw_bytes(4).try_into().unwrap()));
-        let len = BytePos(u32::from_le_bytes(decoder.read_raw_bytes(4).try_into().unwrap()));
-        let hi = lo + len;
+        let mut word = || u32::from_le_bytes(decoder.read_raw_bytes(4).try_into().unwrap());
+        let raw = if tag.kind() == SpanKind::Foreign {
+            [word(), word(), word(), word()]
+        } else {
+            [word(), word(), 0, 0]
+        };
 
         let tcx = decoder.tcx;
 
@@ -627,6 +630,23 @@ impl<'a, 'tcx> Decodable<MetadataDecodeContext<'a, 'tcx>> for SpanData {
             foreign_cdata.imported_source_file(tcx, metadata_index)
         };
 
+        let (lo, hi) = if tag.kind() == SpanKind::Foreign {
+            let file = &source_file.translated_source_file;
+            let end = file.normalized_source_len.0;
+            let at = |line: u32, col: u32| {
+                let start = if line == u32::MAX {
+                    0
+                } else {
+                    file.lines().get(line as usize).map_or(end, |p| p.0)
+                };
+                BytePos(start.saturating_add(col).min(end))
+            };
+            let lo = at(raw[0], raw[1]);
+            (lo, at(raw[2], raw[3]).max(lo))
+        } else {
+            (BytePos(raw[0]), BytePos(raw[0] + raw[1]))
+        };
+
         // Make sure our span is well-formed.
         debug_assert!(
             lo + source_file.original_start_pos <= source_file.original_end_pos,
diff --git a/compiler/rustc_metadata/src/rmeta/encoder.rs b/compiler/rustc_metadata/src/rmeta/encoder.rs
index 8cc6a20..28fa7fc 100644
--- a/compiler/rustc_metadata/src/rmeta/encoder.rs
+++ b/compiler/rustc_metadata/src/rmeta/encoder.rs
@@ -371,8 +371,15 @@ impl<'a, 'tcx> Encodable<EncodeContext<'a, 'tcx>> for SpanData {
             ctxt.encode(s);
         }
         let start = s.position();
-        s.emit_raw_bytes(&lo.0.to_le_bytes());
-        s.emit_raw_bytes(&len.0.to_le_bytes());
+        if kind == SpanKind::Foreign {
+            s.emit_raw_bytes(&line_col_lo.0.to_le_bytes());
+            s.emit_raw_bytes(&line_col_lo.1.to_le_bytes());
+            s.emit_raw_bytes(&line_col_hi.0.to_le_bytes());
+            s.emit_raw_bytes(&line_col_hi.1.to_le_bytes());
+        } else {
+            s.emit_raw_bytes(&lo.0.to_le_bytes());
+            s.emit_raw_bytes(&len.0.to_le_bytes());
+        }
         s.skip_in_hash(start, s.position());
         {
             let mut buf = [0u8; 32];
