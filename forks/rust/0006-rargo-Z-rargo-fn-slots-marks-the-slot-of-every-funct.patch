+    fn rargo_mark_slot(&mut self, instance: Instance<'tcx>) {
+        let name = self.tcx.symbol_name(instance).name.to_string();
+        let index = {
+            let mut slots = self.cx.rargo_slots.borrow_mut();
+            slots.push(name);
+            slots.len() - 1
