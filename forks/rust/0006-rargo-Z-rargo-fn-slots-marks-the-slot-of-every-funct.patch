diff --git a/compiler/rustc_codegen_llvm/src/consts.rs b/compiler/rustc_codegen_llvm/src/consts.rs
index bbb1141a9..ac2da5126 100644
--- a/compiler/rustc_codegen_llvm/src/consts.rs
+++ b/compiler/rustc_codegen_llvm/src/consts.rs
@@ -674,6 +674,46 @@ fn codegen_static_item(&mut self, def_id: DefId) {
         }
     }
 
+    pub(crate) fn rargo_slot_array(&self) -> &'ll Value {
+        if let Some(array) = self.rargo_slot_array.get() {
+            return array;
+        }
+        let array = self.declare_global("__rargo_slots_pending", self.type_array(self.type_i8(), 0));
+        self.rargo_slot_array.set(Some(array));
+        array
+    }
+
+    pub(crate) fn rargo_finish_slots(&mut self) {
+        const RARGO_SLOT_PAGE: usize = 4096;
+        let Some(pending) = self.rargo_slot_array.take() else { return };
+        let mut names = self.rargo_slots.take();
+        names.resize(names.len().next_multiple_of(RARGO_SLOT_PAGE), String::new());
+        let slots_ty = self.type_array(self.type_i8(), names.len() as u64);
+        let slots = self.define_global(&self.generate_local_symbol_name("rargo_slots"), slots_ty).unwrap();
+        llvm::set_initializer(slots, self.const_null(slots_ty));
+        llvm::set_linkage(slots, llvm::Linkage::InternalLinkage);
+        llvm::set_section(slots, c".rargo_slots");
+        set_global_alignment(self, slots, Align::from_bytes(RARGO_SLOT_PAGE as u64).unwrap());
+        let mut bytes = Vec::new();
+        for name in &names {
+            bytes.extend_from_slice(name.as_bytes());
+            bytes.push(0);
+        }
+        let text = self.const_bytes(&bytes);
+        let table = self.define_global(&self.generate_local_symbol_name("rargo_slot_names"), self.val_ty(text)).unwrap();
+        llvm::set_initializer(table, text);
+        llvm::set_linkage(table, llvm::Linkage::InternalLinkage);
+        llvm::LLVMSetGlobalConstant(table, llvm::TRUE);
+        llvm::set_section(table, c".rargo_slot_names");
+        set_global_alignment(self, table, Align::ONE);
+        unsafe {
+            llvm::LLVMReplaceAllUsesWith(pending, slots);
+            llvm::LLVMDeleteGlobal(pending);
+        }
+        self.add_used_global(slots);
+        self.add_used_global(table);
+    }
+
     /// Add a global value to a list to be stored in the `llvm.used` variable, an array of ptr.
     pub(crate) fn add_used_global(&mut self, global: &'ll Value) {
         self.used_statics.push(global);
