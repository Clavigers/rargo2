diff --git a/library/std/src/sys/rargo_slots.rs b/library/std/src/sys/rargo_slots.rs
new file mode 100644
index 000000000..c5ee458e3
--- /dev/null
+++ b/library/std/src/sys/rargo_slots.rs
@@ -0,0 +1,98 @@
+use crate::os::unix::fs::FileExt;
+
+static IN_THIS_IMAGE: u8 = 0;
+
+#[used]
+#[unsafe(link_section = ".init_array.00098")]
+static RARGO_SLOTS_INIT: extern "C" fn() = {
+    extern "C" fn init() {
+        map_slots();
+    }
+    init
+};
+
+fn map_slots() {
+    let path = unsafe { libc::getenv(c"RARGO_FN_SLOTS".as_ptr()) };
+    if path.is_null() || unsafe { *path } == 0 {
+        return;
+    }
+    let Some((start, size)) = slot_range() else { return };
+    let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) };
+    if size == 0 || page <= 0 || start.addr() % page as usize != 0 || size % page as usize != 0 {
+        return;
+    }
+    unsafe {
+        let fd = libc::open(path, libc::O_RDWR | libc::O_CREAT | libc::O_CLOEXEC, 0o644 as libc::c_uint);
+        if fd < 0 {
+            return;
+        }
+        let mut st: libc::stat64 = crate::mem::zeroed();
+        if libc::fstat64(fd, &mut st) != 0 || (st.st_size < size as i64 && libc::ftruncate64(fd, size as i64) != 0) {
+            libc::close(fd);
+            return;
+        }
+        let early: crate::vec::Vec<usize> = (0..size).filter(|&i| crate::ptr::read_volatile(start.add(i)) != 0).collect();
+        let map = libc::mmap64(
+            start as *mut libc::c_void,
+            size,
+            libc::PROT_READ | libc::PROT_WRITE,
+            libc::MAP_SHARED | libc::MAP_FIXED,
+            fd,
+            0,
+        );
+        libc::close(fd);
+        if map == libc::MAP_FAILED {
+            libc::abort();
+        }
+        for i in early {
+            crate::ptr::write_volatile(start.add(i), 1);
+        }
+    }
+}
+
+fn slot_range() -> Option<(*mut u8, usize)> {
+    let exe = crate::fs::File::open("/proc/self/exe").ok()?;
+    let read = |at: u64, len: usize| -> Option<crate::vec::Vec<u8>> {
+        let mut buf = crate::vec![0u8; len];
+        exe.read_exact_at(&mut buf, at).ok()?;
+        Some(buf)
+    };
+    let field = |b: &[u8], at: usize, n: usize| -> Option<u64> {
+        let bytes = b.get(at..at.checked_add(n)?)?;
+        let mut v = [0u8; 8];
+        v[..n].copy_from_slice(bytes);
+        Some(u64::from_le_bytes(v))
+    };
+    let head = read(0, 64)?;
+    if head.get(..6)? != b"\x7fELF\x02\x01" {
+        return None;
+    }
+    let (phoff, phentsize, phnum) = (field(&head, 0x20, 8)?, field(&head, 0x36, 2)? as usize, field(&head, 0x38, 2)? as usize);
+    let (shoff, shentsize, shnum) = (field(&head, 0x28, 8)?, field(&head, 0x3a, 2)? as usize, field(&head, 0x3c, 2)? as usize);
+    let shstrndx = field(&head, 0x3e, 2)? as usize;
+    let phdrs = read(phoff, phentsize.checked_mul(phnum)?)?;
+    let phdr_vaddr = (0..phnum).find_map(|i| {
+        let h = phdrs.get(i * phentsize..)?;
+        let (kind, offset, vaddr, filesz) = (field(h, 0, 4)?, field(h, 8, 8)?, field(h, 16, 8)?, field(h, 32, 8)?);
+        (kind == 1 && offset <= phoff && phoff - offset < filesz).then(|| vaddr + (phoff - offset))
+    })?;
+    let bias = (unsafe { libc::getauxval(libc::AT_PHDR) } as u64).checked_sub(phdr_vaddr)?;
+    let here = (crate::ptr::addr_of!(IN_THIS_IMAGE).addr() as u64).checked_sub(bias)?;
+    (0..phnum).find(|&i| {
+        let Some(h) = phdrs.get(i * phentsize..) else { return false };
+        let (Some(kind), Some(vaddr), Some(memsz)) = (field(h, 0, 4), field(h, 16, 8), field(h, 40, 8)) else { return false };
+        kind == 1 && vaddr <= here && here - vaddr < memsz
+    })?;
+    let shdrs = read(shoff, shentsize.checked_mul(shnum)?)?;
+    let strtab = shdrs.get(shstrndx.checked_mul(shentsize)?..)?;
+    let names = read(field(strtab, 0x18, 8)?, usize::try_from(field(strtab, 0x20, 8)?).ok()?)?;
+    (0..shnum).find_map(|i| {
+        let h = shdrs.get(i * shentsize..)?;
+        let name = names.get(usize::try_from(field(h, 0, 4)?).ok()?..)?;
+        if !name.starts_with(b".rargo_slots\0") {
+            return None;
+        }
+        let (addr, size) = (field(h, 0x10, 8)?, field(h, 0x20, 8)?);
+        Some((crate::ptr::with_exposed_provenance_mut((bias + addr) as usize), usize::try_from(size).ok()?))
+    })
+}
