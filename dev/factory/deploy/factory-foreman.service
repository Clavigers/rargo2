[Unit]
Description=rargo2 factory foreman: takes back stale work, preempts, plans initiatives
After=network-online.target
Wants=network-online.target

[Service]
Environment=HOME=/root
Environment=FACTORY_LOG=/root/factory/log.jsonl
Environment=FACTORY_CODEX=/root/.codex/packages/app-server-daemon/releases/0.172.0-x86_64-unknown-linux-musl/bin/codex
Environment=FACTORY_GROK=/root/.grok/bin/grok
Environment=FACTORY_CLAUDE_CODE=/root/.local/bin/claude
Environment=PYTHONPATH=/root/factory/src
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/root/factory
ExecStart=/root/factory/venv/bin/python -m factory foreman sadosystems/rargo2 /root/factory/plan
Restart=always
RestartSec=10
# Stopping the watchdog leaves running agent sessions alone; a new watchdog adopts them.
KillMode=process

[Install]
WantedBy=multi-user.target
