[Unit]
Description=rargo2 factory power user: uses each release candidate build and files what goes wrong
After=network-online.target
Wants=network-online.target

[Service]
Environment=HOME=/root
Environment=FACTORY_NOTIFY=https://ntfy.sh/wd-c3eaf0b48fad13b9e7a68532
Environment=FACTORY_LOG=/root/factory/log.jsonl
Environment=FACTORY_CODEX=/root/.codex/packages/app-server-daemon/releases/0.172.0-x86_64-unknown-linux-musl/bin/codex
Environment=FACTORY_GROK=/root/.grok/bin/grok
Environment=FACTORY_CLAUDE_CODE=/root/.local/bin/claude
Environment=PYTHONPATH=/root/factory/src
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/root/factory
ExecStart=/root/factory/venv/bin/python -m factory power-user Clavigers/rargo2 /root/factory/use
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
